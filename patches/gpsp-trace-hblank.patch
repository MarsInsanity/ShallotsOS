+typedef struct
+{
+  u32 frame;
+  u32 pc;
+  s32 video_count;
+  u16 vcount;
+  u16 dispstat;
+  u16 extra;
+  u8 kind;
+  u8 mode;
+} shallots_trace_ev;
+
+#define SHALLOTS_TRACE_EVENTS 32768
+static shallots_trace_ev shallots_trace_buf[SHALLOTS_TRACE_EVENTS];
+static u32 shallots_trace_pos;
+u32 shallots_trace_on = 0;
+
+void shallots_trace_init(void)
+{
+  FILE *f = fopen("/mnt/sdcard/gpsp_trace.txt", "rb");
+  shallots_trace_on = (f != NULL);
+  if (f)
+    fclose(f);
+  shallots_trace_pos = 0;
+}
+
+void shallots_trace_event(u32 kind, u32 pc, u32 extra)
+{
+  shallots_trace_ev *ev;
+  u32 vcount = read_ioreg(REG_VCOUNT);
+  if (vcount < 157 || vcount > 162)
+    return;
+  ev = &shallots_trace_buf[shallots_trace_pos++ % SHALLOTS_TRACE_EVENTS];
+  ev->frame = frame_counter;
+  ev->pc = pc;
+  ev->video_count = video_count;
+  ev->vcount = vcount;
+  ev->dispstat = read_ioreg(REG_DISPSTAT);
+  ev->extra = extra;
+  ev->kind = kind;
+  ev->mode = reg[CPU_MODE];
+}
+
+void shallots_trace_dump(void)
+{
+  u32 i, n, start;
+  FILE *f;
+  if (!shallots_trace_on || !shallots_trace_pos)
+    return;
+  f = fopen("/mnt/sdcard/logs/gpsp_trace.log", "w");
+  if (!f)
+    return;
+  n = shallots_trace_pos < SHALLOTS_TRACE_EVENTS ?
+      shallots_trace_pos : SHALLOTS_TRACE_EVENTS;
+  start = shallots_trace_pos - n;
+  fprintf(f, "# kind: H=hblank start V=vcount step I=irq entry X=irq exit "
+             "R=VCOUNT read; vc=cycles to next video event at last update\n");
+  for (i = 0; i < n; i++)
+  {
+    shallots_trace_ev *ev =
+      &shallots_trace_buf[(start + i) % SHALLOTS_TRACE_EVENTS];
+    fprintf(f, "f=%u %c v=%u pc=%08x mode=%u vc=%d ds=%04x x=%04x\n",
+            ev->frame, ev->kind, ev->vcount, ev->pc, ev->mode,
+            ev->video_count, ev->dispstat, ev->extra);
+  }
+  fclose(f);
+}
+
 u32 function_cc update_gba(int remaining_cycles)
 {
   u32 changed_pc = 0;
@@ -164,6 +232,8 @@ u32 function_cc update_gba(int remaining_cycles)
       {
         // Transition from hrefresh to hblank
         dispstat |= 0x02;
+        if (shallots_trace_on)
+          shallots_trace_event('H', reg[REG_PC], 0);
         // HBlank (flag, IRQ and DMA) starts 1008 cycles into the line and
         // lasts 224, as measured on hardware (mGBA d071bff). The old 960/272
         // split made Hamtaro: Ham-Ham Heartbreak stall after "Yep-P".
@@ -258,6 +328,8 @@ u32 function_cc update_gba(int remaining_cycles)
           dispstat &= ~0x04;
 
         write_ioreg(REG_VCOUNT, vcount);
+        if (shallots_trace_on)
+          shallots_trace_event('V', reg[REG_PC], 0);
       }
       write_ioreg(REG_DISPSTAT, dispstat);
     }
